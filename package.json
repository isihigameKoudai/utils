{
  "name": "utils-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @utils/web dev",
    "build": "pnpm --filter @utils/web build",
    "preview": "pnpm --filter @utils/web preview",
    "test": "vitest run",
    "lint": "oxlint packages apps",
    "format": "oxfmt --write packages apps",
    "format:check": "oxfmt --check packages apps",
    "typecheck": "tsrs --noEmit --fast",
    "claude": "npx tsx script/claude.ts",
    "generate:cursorrules": "node script/generate-cursor-rules.js \"**/*.ai.md\" \".cursor/rules/main.mdc\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.0.14",
    "@types/node": "^24.7.1",
    "@vitejs/plugin-react": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint"
    ]
  }
}
