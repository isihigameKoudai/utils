{
  "name": "utils-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "biome check src utils",
    "format": "biome check --write src utils",
    "claude": "npx tsx script/claude.ts",
    "generate:cursorrules": "node script/generate-cursor-rules.js \"**/*.ai.md\" \".cursor/rules/main.mdc\"",
    "tsr": "npx tsr -p tsconfig.src.json -w 'src/main\\.ts$' '.*\\.test\\.ts$'",
    "prepare": "husky"
  },
  "dependencies": {
    "@a2ui/react": "^0.10.1",
    "@a2ui/web_core": "^0.10.4",
    "@google/genai": "^1.51.0",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-router": "1.170.1",
    "@types/lodash-es": "^4.17.12",
    "chromadb": "^3.4.3",
    "dat.gui": "^0.7.9",
    "dayjs": "^1.11.18",
    "lightweight-charts": "^5.0.9",
    "lodash-es": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.1",
    "three": "^0.180.0",
    "typestyle": "^2.4.0",
    "valibot": "^1.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.0.14",
    "@biomejs/biome": "^2.5.3",
    "@tanstack/router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.1",
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "{src,utils}/**/*.{ts,tsx}": [
      "biome check --write"
    ]
  }
}
